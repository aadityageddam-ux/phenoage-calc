# Secure storage - CRITICAL: DO NOT COMMIT THESE FILES
# (previous version had these as trailing inline comments, which git does NOT
# support in .gitignore -- it silently made the whole line part of the pattern,
# so none of these were ever actually ignored despite the warning)
.env
patient_data/*.xlsx
patient_data/*.csv
patient_data/
.git-OLD-CONTAINS-LEAKED-KEY/
.git-STUCK-ATTEMPT-2/
.claude/

# NHANES data (large files, downloaded separately)
nhanes_data/*.XPT
nhanes_data/*.DAT
nhanes_cache/


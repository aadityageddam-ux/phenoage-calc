# PhenoAge Engine - Environment Variables Template
# Copy this file to .env and replace the placeholder with your actual encryption key

# Encryption key for secure patient data storage (AES-256 via Fernet)
# Generate a new key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# IMPORTANT: Keep this key secure and backed up - data cannot be decrypted without it
PHENOAGE_ENCRYPTION_KEY=your-base64-encoded-key-here

# Example of a valid key (DO NOT USE THIS - generate your own):
# PHENOAGE_ENCRYPTION_KEY=h8dK3J9mL2pQ5wR7tY4uI6oP0aS1dF3gH5jK8lZ9xC2vB7nM4qW6eR1tY3u=
